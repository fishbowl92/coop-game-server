<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- 컨트롤러의 저장 흐름을 실제 PostgreSQL 없이 빠르게 검증하는 임시 메모리 DB 제공자입니다. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 컨트롤러 동작을 검증하기 위해 API 프로젝트를 참조합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.Api\CoopGameServer.Api.csproj" />

    <!-- 테스트는 실제 서버와 같은 Contracts 형식을 사용해 프로젝트 연결을 검증합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.Contracts\CoopGameServer.Contracts.csproj" />

    <!-- 순수 게임 규칙과 GameDbContext를 각 책임 프로젝트에서 직접 검증합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.Domain\CoopGameServer.Domain.csproj" />
    <ProjectReference Include="..\..\src\CoopGameServer.Persistence\CoopGameServer.Persistence.csproj" />
  </ItemGroup>

</Project>
