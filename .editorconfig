# EditorConfig는 Visual Studio 등 편집기가 공통 코드 스타일을 따르게 하는 설정 파일입니다.
# 개발자마다 다른 줄바꿈·들여쓰기 설정으로 불필요한 변경이 생기는 것을 줄입니다.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csx}]
# C# 코드에서 System 네임스페이스 using을 먼저 정렬합니다.
dotnet_sort_system_directives_first = true

# 파일 범위 namespace를 권장합니다. 예: namespace CoopGameServer.Contracts;
csharp_style_namespace_declarations = file_scoped:suggestion

# 사용하지 않는 using은 빌드 중 경고로 알려 줍니다.
dotnet_diagnostic.IDE0005.severity = warning

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/CoopGameServer.Persistence/Migrations/*.cs]
# EF Core가 생성한 migration SQL 배열은 사람이 반복 호출하는 코드가 아니므로 CA1861 검사 대상에서 제외합니다.
dotnet_diagnostic.CA1861.severity = none
