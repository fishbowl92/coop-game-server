<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 실제 PostgreSQL Docker 컨테이너를 테스트 중 생성하고 폐기하는 라이브러리입니다. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Testcontainers의 간접 의존성에서 발견된 취약한 SSH.NET 버전을 수정 버전으로 고정합니다. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- 실제 외부 Silo 없이 테스트 프로세스 안에서 PartyGrain을 호출하기 위한 Orleans 테스트 호스트입니다. -->
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- 실제 RewardService와 EF Core 매핑, 마이그레이션을 검증하기 위해 API 프로젝트를 참조합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.Api\CoopGameServer.Api.csproj" />

    <!-- 테스트가 실제 API 요청과 같은 보상 계약을 사용하도록 Contracts 프로젝트를 직접 참조합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.Contracts\CoopGameServer.Contracts.csproj" />

    <!-- PartyGrain의 호출 계약과 실제 구현을 TestCluster에 함께 제공합니다. -->
    <ProjectReference Include="..\..\src\CoopGameServer.GrainContracts\CoopGameServer.GrainContracts.csproj" />
    <ProjectReference Include="..\..\src\CoopGameServer.Grains\CoopGameServer.Grains.csproj" />
  </ItemGroup>

</Project>
